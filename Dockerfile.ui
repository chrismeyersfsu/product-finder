# Dashboard UI (Astro SSR + better-sqlite3, read-only on the shared db).
# Build:  docker build -f Dockerfile.ui -t product-finder-ui .
FROM node:22-slim AS build
WORKDIR /app
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PF_DB=/data/product_finder.db HOST=0.0.0.0 PORT=4321
COPY --from=build /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
VOLUME /data
EXPOSE 4321
CMD ["node", "./dist/server/entry.mjs"]
