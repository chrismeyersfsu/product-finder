---
/** Landing page: a jQuery-Mobile-style listview of every product, one
 * row per product, name only plus a count bubble. The count is
 * `db.deals(slug).length` under the same default (unfiltered,
 * hard-fails-excluded) filters the results page opens with — not
 * productSummaries()'s qualifyingCount, which has no LIMIT and so
 * disagrees with what `/deals/[slug]` actually shows once a product
 * has more than 100 qualifying listings (common in this data set).
 * Calling db.deals() per product is a few cheap indexed queries, not a
 * data-layer change. Tapping a row goes to that product's results;
 * the header's "+" goes to /products/new. `?product=slug` (the old
 * Deals URL) redirects to `/deals/slug` so old links and bookmarks
 * keep working. Swiping a row left (SwipeRow, touch devices) reveals
 * Edit and Delete; Delete posts the same guarded `_action=delete` form
 * as the edit page (confirm() on the client, `confirm=<slug>` checked
 * on the server). `?saved=slug` / `?deleted=slug` (set by
 * /products/[slug] after a save or delete — there is no separate
 * "Manage products" page to land on) render a one-line
 * confirmation. */
export const prerender = false;
import EmptyState from "../components/EmptyState.astro";
import Layout from "../layouts/Layout.astro";
import SwipeRow from "../components/SwipeRow.astro";
import * as db from "../lib/db";

const url = Astro.url;
const legacyProduct = url.searchParams.get("product");
if (legacyProduct) return Astro.redirect(`/deals/${encodeURIComponent(legacyProduct)}`, 303);

const products = db.listProducts().map((p) => ({ ...p, count: db.deals(p.slug).length }));
const saved = url.searchParams.get("saved");
const deleted = url.searchParams.get("deleted");
---
<Layout title="product-finder" active="home" action={{ href: "/products/new", label: "+" }}>
  {!db.hasDb() && <EmptyState what="database" tool="seed_defaults" />}
  {saved && <p class="banner">Saved "{saved}".</p>}
  {deleted && <p class="banner">Deleted "{deleted}".</p>}
  {products.length === 0 ? (
    <EmptyState what="products" tool="seed_defaults" />
  ) : (
    <ul class="listview">
      {products.map((p) => (
        <li>
          <SwipeRow plain>
            <a class="ui-li" href={`/deals/${encodeURIComponent(p.slug)}`}>
              <span class="ui-li-text">{p.name}</span>
              <span class="ui-li-count">{p.count}</span>
              <span class="ui-li-chevron">›</span>
            </a>
            <Fragment slot="panel">
              <a class="swipe-action swipe-action-edit" href={`/products/${encodeURIComponent(p.slug)}`}>Edit</a>
              <form
                class="swipe-action-form"
                method="post"
                action={`/products/${encodeURIComponent(p.slug)}`}
                onsubmit={`return confirm(${JSON.stringify(`Delete "${p.name}" (${p.slug}) and all its listings? This cannot be undone.`)})`}
              >
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="confirm" value={p.slug} />
                <button type="submit" class="swipe-action swipe-action-delete">Delete</button>
              </form>
            </Fragment>
          </SwipeRow>
        </li>
      ))}
    </ul>
  )}
</Layout>
