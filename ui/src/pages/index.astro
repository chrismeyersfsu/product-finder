---
/** Deals dashboard: one filter row scoping the KPI tiles, the deals
 * table, and the manual-checks card below it. Listings first seen in
 * the last NEW_DAYS days are marked "new"; `?new=N` keeps only listings
 * first seen within N days. Each row can be hidden (see /hidden). */
import EmptyState from "../components/EmptyState.astro";
import HideButton from "../components/HideButton.astro";
import SiteMultiSelect from "../components/SiteMultiSelect.astro";
import StatTile from "../components/StatTile.astro";
import Layout from "../layouts/Layout.astro";
import { siteVar } from "../lib/colors";
import * as db from "../lib/db";
import { day, money, moneyCents, perUnit } from "../lib/format";

const products = db.listProducts();
const url = Astro.url;
const productSlug = url.searchParams.get("product") || products[0]?.slug || "";
const product = products.find((p) => p.slug === productSlug);
const minScore = url.searchParams.get("min_score");
const maxPrice = url.searchParams.get("max_price");
const selectedSites = (url.searchParams.get("sites") ?? "").split(",").filter(Boolean);
const includeHardFails = url.searchParams.get("hard_fails") === "1";
const within = url.searchParams.get("within");
const newWithin = url.searchParams.get("new");
const homeHint = db.homeHint();
/** How recent "new" is on the badge and the tile. */
const NEW_DAYS = 2;
const newSince = db.sinceIso(NEW_DAYS);
const isNew = (r: db.Listing) => r.first_seen >= newSince;
const filters: db.DealFilters = {
  minScore: minScore ? Number(minScore) : undefined,
  maxPrice: maxPrice ? Number(maxPrice) : undefined,
  sites: selectedSites.length ? selectedSites : undefined,
  includeHardFails,
  maxDistance: within ? Number(within) : undefined,
  newWithinDays: newWithin ? Number(newWithin) : undefined,
};
const rows = product ? db.deals(productSlug, filters) : [];
const sites = product ? db.listingSites(productSlug) : [];
const knownSites = db.listSites().map((s) => s.slug);
const priced = rows.filter((r) => r.price != null && r.price > 0);
const best = priced.length ? Math.min(...priced.map((r) => r.price!)) : null;
const median = priced[0]?.median_price ?? null;
const nSites = new Set(rows.map((r) => r.site_slug)).size;
const nNew = rows.filter(isNew).length;
const back = url.pathname + url.search;
// Columns with nothing in any row (cars have no $/unit; dealer sites no
// seller rating) are dropped outright so the rest fits without scrolling.
const noUnit = !rows.some((r) => r.unit_price != null && r.unit);
const noSeller = !rows.some((r) => r.seller_rating != null || r.seller_feedback_count != null);
---
<Layout title="Deals" active="deals" product={productSlug}>
  {!db.hasDb() && <EmptyState what="database" tool="seed_defaults" />}
  <form class="filters" method="get" action="/">
    <label>Product
      <select name="product">
        {products.map((p) => <option value={p.slug} selected={p.slug === productSlug}>{p.name}</option>)}
      </select>
    </label>
    <label>Min score
      <input type="number" name="min_score" min="0" max="1" step="0.05" value={minScore ?? ""} placeholder="0.5" />
    </label>
    <label>Max price
      <input type="number" name="max_price" min="0" step="10" value={maxPrice ?? ""} placeholder="any" />
    </label>
    <SiteMultiSelect options={sites} selected={selectedSites} />
    <label title={homeHint ? `Miles from home (${homeHint}); listings with no known location are hidden when set` : "Set a home address with set_home(address) to enable"}>
      <span>Within{homeHint && <span class="hint"> of {homeHint}</span>}</span>
      <input type="number" name="within" min="1" step="any" inputmode="numeric" value={within ?? ""} placeholder="any mi" disabled={!homeHint} />
    </label>
    <label title="Only listings first seen within this many days">New within
      <input type="number" name="new" min="0.5" step="any" inputmode="numeric" value={newWithin ?? ""} placeholder="any days" />
    </label>
    <label class="chk"><input type="checkbox" name="hard_fails" value="1" checked={includeHardFails} /> include hard fails</label>
    <button type="submit">Apply</button>
  </form>

  {product ? (
    <>
      <div class="tiles">
        <StatTile label="Qualifying listings" value={String(rows.length)} hint={includeHardFails ? "incl. hard fails" : "hard fails excluded"} />
        <StatTile label="Best price" value={money(best)} />
        <StatTile label="Median price" value={money(median)} />
        <StatTile label="Sites reporting" value={String(nSites)} hint={`${sites.length} with any listing`} />
        <StatTile label={`New in ${NEW_DAYS}d`} value={String(nNew)} hint="first seen recently" />
      </div>

      {rows.length === 0 ? (
        <EmptyState what={`listings for ${product.name}`} tool={`run_search("${productSlug}")`} />
      ) : (
        <div class="card">
          <h2>Best deals <span class="sub">— sorted by score, then price; click $/unit to sort by price per ounce, First seen for newest; Hide removes a row for good (undo on the Hidden page)</span></h2>
          <div class="wrap-x">
            <table class="data cards" data-sortable>
              <thead>
                <tr>
                  <th>Listing</th><th>Site</th><th class="num">Price</th>
                  <th class:list={["num", { "col-blank": noUnit }]} title="Price per ounce (weight or fluid), or per count when the pack size has no weight; from the listing title">$/unit</th>
                  <th class="num">vs median</th>
                  <th class="num" aria-sort="descending">Score</th><th class="num" title={homeHint ? `Miles from ${homeHint}` : "Miles from home"}>≈ mi</th>
                  <th>Condition</th><th class:list={["num", { "col-blank": noSeller }]}>Seller</th>
                  <th title="First scrape that found this listing">First seen</th><th>Last seen</th><th></th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <td class="c-title">
                      <div class="titled">
                        {r.image_url && <img class="thumb" src={r.image_url} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />}
                        <div>
                          <a href={r.url} rel="noopener noreferrer" target="_blank">{r.title || r.url}</a>
                          {isNew(r) && <span class="badge badge-new" title={`First seen ${r.first_seen.slice(0, 16).replace("T", " ")} UTC`}>new</span>}
                          {r.hard_fails.length > 0 && <div class="status status-critical"><span class="ic">✗</span>{r.hard_fails.join("; ")}</div>}
                        </div>
                      </div>
                    </td>
                    <td data-label="Site"><span class="swatch" style={`background:${siteVar(r.site_slug, knownSites)}`}></span>{r.site_slug}</td>
                    <td class="num" data-label="Price">{moneyCents(r.price)}</td>
                    <td class:list={["num", { "c-empty": r.unit_price == null || !r.unit, "col-blank": noUnit }]} data-label="$/unit">{perUnit(r.unit_price, r.unit)}</td>
                    <td class:list={["num", { "c-empty": r.pct_vs_median == null }]} data-label="vs median">{r.pct_vs_median == null ? "—" : `${r.pct_vs_median > 0 ? "+" : ""}${r.pct_vs_median}%`}</td>
                    <td class="num" data-label="Score">{r.score == null ? "—" : r.score.toFixed(2)}</td>
                    <td class:list={["num", { "c-empty": r.distance_mi == null }]} data-label="≈ mi">{r.distance_mi == null ? "—" : r.distance_mi.toFixed(0)}</td>
                    <td class:list={["c-wide", { "c-empty": !r.condition }]} data-label="Condition">{r.condition ?? "—"}</td>
                    <td class:list={["num", "c-minor", { "col-blank": noSeller }]} data-label="Seller">{r.seller_rating != null ? `${r.seller_rating}%` : "—"}{r.seller_feedback_count != null ? ` (${r.seller_feedback_count.toLocaleString()})` : ""}</td>
                    <td data-label="First seen">{day(r.first_seen)}</td>
                    <td class="c-minor" data-label="Last seen">{day(r.last_seen)}</td>
                    <td class="c-act"><HideButton id={r.id} hidden={false} back={back} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {product.manual_checks.length > 0 && (
        <div class="card">
          <h2>Verify by hand before buying</h2>
          <ul>
            {product.manual_checks.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      )}
    </>
  ) : (
    <EmptyState what="products" tool="seed_defaults" />
  )}
</Layout>
