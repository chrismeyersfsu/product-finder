---
/** Price-history explorer: date-range + kind filters scoping the
 * scatter and its table twin. */
import EmptyState from "../components/EmptyState.astro";
import HistoryChart from "../components/HistoryChart.astro";
import SiteMultiSelect from "../components/SiteMultiSelect.astro";
import StatTile from "../components/StatTile.astro";
import Layout from "../layouts/Layout.astro";
import * as db from "../lib/db";
import { day, money } from "../lib/format";

const products = db.listProducts();
const url = Astro.url;
const productSlug = url.searchParams.get("product") || products[0]?.slug || "";
const kind = url.searchParams.get("kind") || "";
const selectedSites = (url.searchParams.get("sites") ?? "").split(",").filter(Boolean);
const range = url.searchParams.get("range") || "365";
let obs = productSlug ? db.history(productSlug, kind || undefined) : [];
if (selectedSites.length) obs = obs.filter((o) => selectedSites.includes(o.site_slug));
const historySiteOptions = productSlug ? db.historySites(productSlug) : [];
if (range !== "all") {
  const cutoff = Date.now() - Number(range) * 86400_000;
  obs = obs.filter((o) => Date.parse(o.observed_at) >= cutoff);
}
const knownSites = db.listSites().map((s) => s.slug);
const prices = obs.map((o) => o.price);
const sold = obs.filter((o) => o.kind === "sold").length;
---
<Layout title="Price history" active="history" product={productSlug}>
  <form class="filters" method="get" action="/history">
    <label>Product
      <select name="product">
        {products.map((p) => <option value={p.slug} selected={p.slug === productSlug}>{p.name}</option>)}
      </select>
    </label>
    <label>Date range
      <select name="range">
        <option value="7" selected={range === "7"}>last 7 days</option>
        <option value="30" selected={range === "30"}>last 30 days</option>
        <option value="90" selected={range === "90"}>last 90 days</option>
        <option value="365" selected={range === "365"}>last year</option>
        <option value="all" selected={range === "all"}>all time</option>
      </select>
    </label>
    <SiteMultiSelect options={historySiteOptions} selected={selectedSites} />
    <label>Kind
      <select name="kind">
        <option value="">seen + sold</option>
        <option value="seen" selected={kind === "seen"}>seen (asking)</option>
        <option value="sold" selected={kind === "sold"}>sold (real sales)</option>
      </select>
    </label>
    <button type="submit">Apply</button>
  </form>

  {obs.length === 0 ? (
    <EmptyState what="price observations" tool={`backfill_ebay_sold("${productSlug || "…"}") or run_search`} />
  ) : (
    <>
      <div class="tiles">
        <StatTile label="Observations" value={obs.length.toLocaleString()} hint={`${sold.toLocaleString()} sold · ${(obs.length - sold).toLocaleString()} seen`} />
        <StatTile label="Lowest" value={money(Math.min(...prices))} />
        <StatTile label="Highest" value={money(Math.max(...prices))} />
        <StatTile label="Span" value={`${day(obs[0]!.observed_at)} → ${day(obs[obs.length - 1]!.observed_at)}`} />
      </div>
      <div class="card">
        <h2>Observed prices over time</h2>
        <HistoryChart obs={obs} knownSites={knownSites} />
        <details class="tableview">
          <summary>Table view ({obs.length} rows)</summary>
          <div class="wrap-x">
            <table class="data" data-sortable>
              <thead><tr><th>Date</th><th>Site</th><th class="num">Price</th><th>Kind</th><th class="num">Score</th><th>Listing</th></tr></thead>
              <tbody>
                {[...obs].reverse().map((o) => (
                  <tr>
                    <td>{day(o.observed_at)}</td>
                    <td>{o.site_slug}</td>
                    <td class="num">{money(o.price)}</td>
                    <td>{o.kind}</td>
                    <td class="num">{o.score ?? "—"}</td>
                    <td>{o.url ? <a href={o.url} rel="noopener noreferrer" target="_blank">{o.title || o.url}</a> : o.title}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </>
  )}
</Layout>
