---
/** Site health: which scrapers actually work. Status is icon + label,
 * never color alone. */
import EmptyState from "../components/EmptyState.astro";
import Layout from "../layouts/Layout.astro";
import { siteVar } from "../lib/colors";
import * as db from "../lib/db";

const sites = db.listSites();
const knownSites = sites.map((s) => s.slug);
const runs = db.recentRuns(10);
// Latest per-site outcome across recent runs (newest first wins)
const latest = new Map<string, { listings?: number; error?: string | null; strategy?: string; run: string }>();
for (const run of runs)
  for (const [slug, r] of Object.entries(run.site_results))
    if (!latest.has(slug)) latest.set(slug, { ...r, run: run.started_at });
---
<Layout title="Sites" active="sites">
  {sites.length === 0 ? (
    <EmptyState what="sites" tool="seed_defaults" />
  ) : (
    <div class="card">
      <h2>Site health <span class="sub">— latest result per site, {runs.length} recent runs</span></h2>
      <div class="wrap-x">
        <table class="data">
          <thead><tr><th>Site</th><th>Strategy</th><th>Enabled</th><th>Last result</th><th class="num">Listings</th><th>Last error</th></tr></thead>
          <tbody>
            {sites.map((s) => {
              const r = latest.get(s.slug);
              return (
                <tr>
                  <td><span class="swatch" style={`background:${siteVar(s.slug, knownSites)}`}></span>{s.name}</td>
                  <td><span class="badge">{s.kind}</span></td>
                  <td>{s.enabled ? "yes" : "no"}</td>
                  <td>
                    {!r ? (
                      <span class="status status-muted"><span class="ic">○</span>never searched</span>
                    ) : r.error ? (
                      <span class="status status-critical"><span class="ic">✗</span>failing</span>
                    ) : (
                      <span class="status status-good"><span class="ic">✓</span>working{r.strategy ? ` (${r.strategy})` : ""}</span>
                    )}
                  </td>
                  <td class="num">{r?.listings ?? "—"}</td>
                  <td>{r?.error ?? ""}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="caveats">Some marketplaces bot-block; a failing site records its error and the search continues. Strategies fall back API → HTML → browser.</p>
    </div>
  )}
</Layout>
