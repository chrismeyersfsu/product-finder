---
/** Every listing hidden from deals, newest first, with an Unhide
 * button per row. Hidden rows keep refreshing on scrapes, so price and
 * last seen here are current. */
import EmptyState from "../components/EmptyState.astro";
import HideButton from "../components/HideButton.astro";
import Layout from "../layouts/Layout.astro";
import { siteVar } from "../lib/colors";
import * as db from "../lib/db";
import { day, moneyCents } from "../lib/format";

const url = Astro.url;
const productSlug = url.searchParams.get("product") || "";
const products = db.listProducts();
const rows = db.hiddenListings(productSlug || undefined);
const knownSites = db.listSites().map((s) => s.slug);
const back = url.pathname + url.search;
---
<Layout title="Hidden" active="hidden" product={productSlug || undefined}>
  {!db.hasDb() && <EmptyState what="database" tool="seed_defaults" />}
  <form class="filters" method="get" action="/hidden">
    <label>Product
      <select name="product">
        <option value="" selected={!productSlug}>All products</option>
        {products.map((p) => <option value={p.slug} selected={p.slug === productSlug}>{p.name}</option>)}
      </select>
    </label>
    <button type="submit">Apply</button>
  </form>

  {rows.length === 0 ? (
    <div class="empty">
      <p>Nothing hidden{productSlug ? " for this product" : ""}.</p>
      <p>Use <strong>Hide</strong> on a row of the Deals page to keep it out of the way; it will show up here.</p>
    </div>
  ) : (
    <div class="card">
      <h2>Hidden listings <span class="sub">— {rows.length} kept out of deals; Unhide puts one back</span></h2>
      <div class="wrap-x">
        <table class="data" data-sortable>
          <thead>
            <tr>
              <th>Listing</th><th>Product</th><th>Site</th><th class="num">Price</th>
              <th class="num">Score</th><th>Condition</th><th>Last seen</th>
              <th aria-sort="descending">Hidden</th><th></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td><a href={r.url} rel="noopener noreferrer" target="_blank">{r.title || r.url}</a></td>
                <td><a href={`/?product=${encodeURIComponent(r.product_slug)}`}>{r.product_name}</a></td>
                <td><span class="swatch" style={`background:${siteVar(r.site_slug, knownSites)}`}></span>{r.site_slug}</td>
                <td class="num">{moneyCents(r.price)}</td>
                <td class="num">{r.score == null ? "—" : r.score.toFixed(2)}</td>
                <td>{r.condition ?? "—"}</td>
                <td>{day(r.last_seen)}</td>
                <td>{(r.hidden_at ?? "").slice(0, 16).replace("T", " ")}</td>
                <td><HideButton id={r.id} hidden={true} back={back} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</Layout>
