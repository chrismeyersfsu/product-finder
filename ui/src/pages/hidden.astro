---
/** Every listing hidden from deals across every product, newest first,
 * with an Unhide button per row; an optional Product select narrows it
 * to one. Hidden rows keep refreshing on scrapes, so price and last
 * seen here are current. Styled as the same jQuery-Mobile listview as
 * the results page, with the product name on its meta line since rows
 * can span every product. */
import EmptyState from "../components/EmptyState.astro";
import HideButton from "../components/HideButton.astro";
import Layout from "../layouts/Layout.astro";
import { siteVar } from "../lib/colors";
import * as db from "../lib/db";
import { day, moneyCents } from "../lib/format";

const url = Astro.url;
const productSlug = url.searchParams.get("product") || "";
const products = db.listProducts();
const rows = db.hiddenListings(productSlug || undefined);
const knownSites = db.listSites().map((s) => s.slug);
const back = url.pathname + url.search;
---
<Layout title="Hidden" active="hidden">
  {!db.hasDb() && <EmptyState what="database" tool="seed_defaults" />}
  <details class="collapsible" open={!!productSlug}>
    <summary>Product{productSlug && <span class="badge">1 active</span>}</summary>
    <div class="collapsible-body">
      <form class="filters" method="get" action="/hidden">
        <label>Product
          <select name="product" onchange="this.form.requestSubmit()">
            <option value="" selected={!productSlug}>All products</option>
            {products.map((p) => <option value={p.slug} selected={p.slug === productSlug}>{p.name}</option>)}
          </select>
        </label>
        <button type="submit">Apply</button>
      </form>
    </div>
  </details>

  {rows.length === 0 ? (
    <div class="empty">
      <p>Nothing hidden{productSlug ? " for this product" : ""}.</p>
      <p>Use <strong>Hide</strong> on a row of a results page to keep it out of the way; it will show up here.</p>
    </div>
  ) : (
    <ul class="listview">
      {rows.map((r) => (
        <li class="ui-li-has-thumb">
          <div class="ui-li">
            {r.image_url ? (
              <img class="ui-li-thumb" src={r.image_url} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />
            ) : (
              <span class="ui-li-thumb-placeholder">no photo</span>
            )}
            <div class="ui-li-body">
              <a class="ui-li-title" href={r.url} rel="noopener noreferrer" target="_blank">{r.title || r.url}</a>
              <div class="ui-li-price-row">
                <span class="ui-li-price">{moneyCents(r.price)}</span>
              </div>
              <div class="ui-li-meta">
                <a href={`/deals/${encodeURIComponent(r.product_slug)}`}>{r.product_name}</a>
                {" · "}<span class="swatch" style={`background:${siteVar(r.site_slug, knownSites)}`}></span>{r.site_slug}
                {" · score "}{r.score == null ? "—" : r.score.toFixed(2)}
                {" · "}{r.condition ?? "—"}
                {" · last seen "}{day(r.last_seen)}
                {" · hidden "}{(r.hidden_at ?? "").slice(0, 10)}
              </div>
            </div>
            <div class="ui-li-aside">
              <HideButton id={r.id} hidden={true} back={back} />
            </div>
          </div>
        </li>
      ))}
    </ul>
  )}
</Layout>
