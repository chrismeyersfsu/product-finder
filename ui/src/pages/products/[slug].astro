---
/** Edit (or delete) one product. Slug is fixed to the URL and never
 * taken from the form. Handles its own POST: same-origin check, then
 * one of three actions — delete (_action=delete, guarded by a
 * confirm() on the client and a matching hidden `confirm` field on
 * the server; redirects to the product list, `/?deleted=<slug>`),
 * scrape (_action=scrape, drops a scrape-now queue file and redirects
 * back), or the main form (parse + validate, re-render with errors on
 * failure, save + redirect to the product list on success,
 * `/?saved=<slug>`; the list renders both banners). `?created=1&queued=0|1`
 * (set by /products/new after a create) and `?scrape=queued` (set
 * after this page's own Scrape now button) render one-line
 * confirmations here. Unknown slug -> 404. */
export const prerender = false;
import ProductForm from "../../components/ProductForm.astro";
import Layout from "../../layouts/Layout.astro";
import * as db from "../../lib/db";
import { day, hhmm } from "../../lib/format";
import { deleteProduct, formDefaults, parseProductForm, saveProduct } from "../../lib/products";
import { sameOrigin } from "../../lib/request";
import { enqueueScrape, scrapeStatus } from "../../lib/scrapeQueue";

const slug = Astro.params.slug ?? "";
const product = db.productFull(slug);
if (!product) return new Response("no such product", { status: 404 });

const siteRows = db.listSites();
const knownSites = siteRows.map((s) => s.slug);
let values = formDefaults(product);
let errors: string[] = [];

if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request)) return new Response("Cross-site POST refused", { status: 403 });
  const form = await Astro.request.formData();
  const action = form.get("_action");

  if (action === "delete") {
    if (String(form.get("confirm") ?? "") !== slug) return new Response("confirmation mismatch", { status: 400 });
    deleteProduct(slug);
    return Astro.redirect(`/?deleted=${encodeURIComponent(slug)}`, 303);
  }

  if (action === "scrape") {
    enqueueScrape(slug);
    return Astro.redirect(`/products/${encodeURIComponent(slug)}?scrape=queued`, 303);
  }

  const parsed = parseProductForm(form, { slugLocked: slug, knownSites });
  errors = parsed.errors;
  if (errors.length === 0) {
    saveProduct(parsed.product);
    return Astro.redirect(`/?saved=${encodeURIComponent(slug)}`, 303);
  }
  values = formDefaults(parsed.product);
}

const summary = db.productSummaries().find((s) => s.slug === slug);
const created = Astro.url.searchParams.get("created") === "1";
const queuedOnCreate = Astro.url.searchParams.get("queued") === "1";

const scrape = scrapeStatus(slug);
let scrapeLine = "";
if (scrape.runningSince) scrapeLine = `Running since ${hhmm(scrape.runningSince)}`;
else if (scrape.queued) scrapeLine = "Queued — waiting for the scraper";
else if (scrape.last) scrapeLine = `Last on-demand scrape ${hhmm(scrape.last.at)}: ${scrape.last.text}`;
---
<Layout title={`Edit ${product.name}`} active="home">
  <div class="card">
    <h2>
      Edit product <span class="sub">— {slug}, created {day(product.created_at)}, updated {day(product.updated_at)}</span>
    </h2>
    {created && (
      <p class="banner">
        {queuedOnCreate
          ? `Saved "${product.name}" — first scrape queued; results show up on Deals within a few minutes.`
          : `Saved "${product.name}".`}
      </p>
    )}
    {summary && (
      <p class="hint">
        {summary.listingCount} listings, {summary.qualifyingCount} qualifying, {summary.flaggedCount > 0 ? `⚠ ${summary.flaggedCount} flagged` : "0 flagged"}.
        {" "}<a href={`/deals/${encodeURIComponent(slug)}`}>Deals →</a>
      </p>
    )}

    <div class="scrape-block">
      <form method="post" action={`/products/${encodeURIComponent(slug)}`}>
        <input type="hidden" name="_action" value="scrape" />
        <button type="submit" class="btn-scrape">Scrape now</button>
      </form>
      {scrapeLine && <span class="hint">{scrapeLine}</span>}
    </div>

    <ProductForm action={`/products/${encodeURIComponent(slug)}`} values={values} errors={errors} siteRows={siteRows} slugLocked />
  </div>
  <div class="card">
    <h2>Delete this product</h2>
    <p class="hint">Removes the product and every stored listing for it (price history is kept). This can't be undone.</p>
    <form
      class="delete-form"
      method="post"
      action={`/products/${encodeURIComponent(slug)}`}
      onsubmit={`return confirm(${JSON.stringify(`Delete "${product.name}" (${slug}) and all its listings? This cannot be undone.`)})`}
    >
      <input type="hidden" name="_action" value="delete" />
      <input type="hidden" name="confirm" value={slug} />
      <button type="submit" class="btn-danger">Delete product</button>
    </form>
  </div>
</Layout>
