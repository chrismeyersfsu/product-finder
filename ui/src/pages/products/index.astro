---
/** Product roster: one row per product with its query/site scope and
 * roll-ups over its listings. Name links to the edit page; Deals links
 * to the filtered dashboard. `?saved=slug` / `?deleted=slug` (set by
 * the new/edit pages after a POST) render a one-line confirmation. */
import EmptyState from "../../components/EmptyState.astro";
import Layout from "../../layouts/Layout.astro";
import * as db from "../../lib/db";
import { day } from "../../lib/format";
import { scrapeStatuses } from "../../lib/scrapeQueue";

const products = db.productSummaries();
const saved = Astro.url.searchParams.get("saved");
const deleted = Astro.url.searchParams.get("deleted");
const scrapes = scrapeStatuses();
---
<Layout title="Products" active="products">
  {!db.hasDb() && <EmptyState what="database" tool="seed_defaults" />}
  {saved && <p class="banner">Saved "{saved}".</p>}
  {deleted && <p class="banner">Deleted "{deleted}".</p>}
  <p class="actions-row"><a class="btn" href="/products/new">New product</a></p>

  {products.length === 0 ? (
    <EmptyState what="products" tool="seed_defaults" />
  ) : (
    <div class="card">
      <h2>Products <span class="sub">— {products.length} configured; qualifying passes every hard fail and isn't hidden</span></h2>
      <div class="wrap-x">
        <table class="data cards" data-sortable>
          <thead>
            <tr>
              <th>Name</th><th>Slug</th><th class="num">Queries</th><th>Sites</th>
              <th class="num">Listings</th><th class="num">Qualifying</th><th class="num">Flagged</th>
              <th>Last seen</th><th>Deals</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr>
                <td class="c-title"><a href={`/products/${encodeURIComponent(p.slug)}`}>{p.name}</a></td>
                <td class="c-minor" data-label="Slug">{p.slug}</td>
                <td class="num" data-label="Queries">{p.queryCount}</td>
                <td class="c-wide" data-label="Sites">{p.sites.length ? p.sites.join(", ") : "all enabled"}</td>
                <td class="num" data-label="Listings">{p.listingCount}</td>
                <td class="num" data-label="Qualifying">{p.qualifyingCount}</td>
                <td class:list={["num", { "c-empty": p.flaggedCount === 0 }]} data-label="Flagged">{p.flaggedCount > 0 ? `⚠ ${p.flaggedCount}` : "0"}</td>
                <td class="c-minor" data-label="Last seen">
                  {p.lastSeen ? day(p.lastSeen) : "—"}
                  {scrapes.get(p.slug)?.runningSince && <span class="scrape-tag">running</span>}
                  {!scrapes.get(p.slug)?.runningSince && scrapes.get(p.slug)?.queued && <span class="scrape-tag">queued</span>}
                </td>
                <td class="c-wide" data-label="Deals"><a href={`/?product=${encodeURIComponent(p.slug)}`}>Deals →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</Layout>
