---
/** Expected best price vs lookback window: single-series dot-line
 * (slot 1). Insufficient-data windows render hollow, muted, and
 * flagged. Direct labels on the endpoints and the minimum only; the
 * tooltip and table view carry the rest. */
import { moneyCents, windowLabel } from "../lib/format";
import { niceTicks, pad, scaleLinear } from "../lib/viz";
interface Win { days: number; mean: number | null; median: number | null; min: number | null; n: number; insufficient: boolean }
interface Props { windows: Win[] }
const { windows } = Astro.props;
const W = 720, H = 250, ML = 56, MR = 56, MT = 14, MB = 30;
const withData = windows.filter((w) => w.mean != null);
const xs = scaleLinear([0, windows.length - 1 || 1], [ML, W - MR]);
const vals = withData.flatMap((w) => [w.mean!, w.median!]);
const dom = pad([Math.min(...vals), Math.max(...vals)]);
const ys = scaleLinear([dom[0], dom[1]], [H - MB, MT]);
const ticks = niceTicks(dom[0], dom[1], 4);
const pts = windows.map((w, i) => ({ ...w, x: xs(i), y: w.mean != null ? ys(w.mean) : null }));
const linePts = pts.filter((p) => p.y != null && !p.insufficient);
const path = linePts.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(1)},${p.y!.toFixed(1)}`).join(" ");
const minMean = Math.min(...withData.filter((w) => !w.insufficient).map((w) => w.mean ?? Infinity));
const labelIdx = new Set<number>();
const solid = pts.filter((p) => p.y != null && !p.insufficient);
if (solid.length) {
  labelIdx.add(pts.indexOf(solid[0]!));
  labelIdx.add(pts.indexOf(solid[solid.length - 1]!));
  const minPt = solid.find((p) => p.mean === minMean);
  if (minPt) labelIdx.add(pts.indexOf(minPt));
}
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mean best price found, by lookback window">
    {ticks.map((t) => (
      <g>
        <line x1={ML} x2={W - MR} y1={ys(t)} y2={ys(t)} stroke="var(--grid)" stroke-width="1" />
        <text class="axis-text" x={ML - 8} y={ys(t) + 3} text-anchor="end">${t.toLocaleString()}</text>
      </g>
    ))}
    <line x1={ML} x2={W - MR} y1={H - MB} y2={H - MB} stroke="var(--baseline)" stroke-width="1" />
    {pts.map((p) => (
      <text class="axis-text" x={p.x} y={H - MB + 16} text-anchor="middle">{windowLabel(p.days)}</text>
    ))}
    <path d={path} fill="none" stroke="var(--cat-1)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
    {pts.map((p, i) =>
      p.y == null ? null : (
        <g>
          {p.insufficient ? (
            <circle cx={p.x} cy={p.y} r="5" fill="var(--surface-1)" stroke="var(--other)" stroke-width="2" />
          ) : (
            <circle cx={p.x} cy={p.y} r="5" fill="var(--cat-1)" stroke="var(--surface-1)" stroke-width="2" />
          )}
          {labelIdx.has(i) && !p.insufficient && (
            <text class={p.mean === minMean ? "dlabel-strong" : "dlabel"} x={p.x} y={p.y - 12} text-anchor="middle">{moneyCents(p.mean)}</text>
          )}
          {p.insufficient && (
            <text class="dlabel" x={p.x} y={p.y - 12} text-anchor="middle">n&lt;30</text>
          )}
          <circle
            cx={p.x} cy={p.y} r="14" fill="transparent" tabindex="0"
            data-tip-value={moneyCents(p.mean)}
            data-tip-label={`mean best price · ${windowLabel(p.days)} window\nmedian ${moneyCents(p.median)} · lowest ${moneyCents(p.min)}\n${p.n} pivots with data${p.insufficient ? " — insufficient (<30)" : ""}`}
          />
        </g>
      )
    )}
  </svg>
  <figcaption>Mean best price a buyer would have found, by lookback window. Hollow dots: fewer than 30 pivots — not interpretable.</figcaption>
</figure>
<details class="tableview">
  <summary>Table view</summary>
  <table class="data">
    <thead><tr><th>Window</th><th class="num">Pivots</th><th class="num">Mean best</th><th class="num">Median best</th><th class="num">Lowest</th><th>Flag</th></tr></thead>
    <tbody>
      {windows.map((w) => (
        <tr>
          <td>{windowLabel(w.days)}</td>
          <td class="num">{w.n}</td>
          <td class="num">{moneyCents(w.mean)}</td>
          <td class="num">{moneyCents(w.median)}</td>
          <td class="num">{moneyCents(w.min)}</td>
          <td>{w.insufficient ? "insufficient data" : ""}</td>
        </tr>
      ))}
    </tbody>
  </table>
</details>
