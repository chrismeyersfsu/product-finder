---
/** One KPI stat tile: label, value, optional hint line. */
interface Props { label: string; value: string; hint?: string | undefined }
const { label, value, hint } = Astro.props;
---
<div class="tile">
  <div class="label">{label}</div>
  <div class="value">{value}</div>
  {hint && <div class="hint">{hint}</div>}
</div>
