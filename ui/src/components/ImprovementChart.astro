---
/** Savings from waiting: diverging columns of mean improvement vs the
 * shortest window, 95% bootstrap CI whiskers. Polarity encoding:
 * above zero (cheaper) = cool pole, below = warm pole; zero line is
 * the baseline. One axis. */
import { moneyCents, pct, windowLabel } from "../lib/format";
import { niceTicks, pad, scaleLinear } from "../lib/viz";
interface Imp { days: number; baseline: number; mean: number; pctv: number; ci: [number, number]; frac: number; n: number }
interface Props { imps: Imp[] }
const { imps } = Astro.props;
const W = 720, H = 250, ML = 56, MR = 20, MT = 14, MB = 30;
const lo = Math.min(0, ...imps.flatMap((d) => [d.ci[0], d.mean]));
const hi = Math.max(0, ...imps.flatMap((d) => [d.ci[1], d.mean]));
const dom = pad([lo, hi]);
const ys = scaleLinear([dom[0], dom[1]], [H - MB, MT]);
const ticks = niceTicks(dom[0], dom[1], 4);
const band = (W - ML - MR) / Math.max(imps.length, 1);
const bw = Math.min(24, band * 0.5);
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mean savings vs shortest window, with 95% CI">
    {ticks.map((t) => (
      <g>
        <line x1={ML} x2={W - MR} y1={ys(t)} y2={ys(t)} stroke="var(--grid)" stroke-width="1" />
        <text class="axis-text" x={ML - 8} y={ys(t) + 3} text-anchor="end">${t.toLocaleString()}</text>
      </g>
    ))}
    <line x1={ML} x2={W - MR} y1={ys(0)} y2={ys(0)} stroke="var(--baseline)" stroke-width="1" />
    {imps.map((d, i) => {
      const cx = ML + band * (i + 0.5);
      const y0 = ys(0);
      const y1 = ys(d.mean);
      const top = Math.min(y0, y1);
      const h = Math.abs(y0 - y1);
      const up = d.mean >= 0;
      const rx = 4;
      const bx = cx - bw / 2;
      const path = up
        ? `M${bx},${y0} L${bx},${top + rx} Q${bx},${top} ${bx + rx},${top} L${bx + bw - rx},${top} Q${bx + bw},${top} ${bx + bw},${top + rx} L${bx + bw},${y0} Z`
        : `M${bx},${y0} L${bx},${top + h - rx} Q${bx},${top + h} ${bx + rx},${top + h} L${bx + bw - rx},${top + h} Q${bx + bw},${top + h} ${bx + bw},${top + h - rx} L${bx + bw},${y0} Z`;
      return (
        <g>
          <path d={path} fill={up ? "var(--div-pos)" : "var(--div-neg)"} />
          <line x1={cx} x2={cx} y1={ys(d.ci[0])} y2={ys(d.ci[1])} stroke="var(--text-secondary)" stroke-width="1.5" />
          <line x1={cx - 5} x2={cx + 5} y1={ys(d.ci[0])} y2={ys(d.ci[0])} stroke="var(--text-secondary)" stroke-width="1.5" />
          <line x1={cx - 5} x2={cx + 5} y1={ys(d.ci[1])} y2={ys(d.ci[1])} stroke="var(--text-secondary)" stroke-width="1.5" />
          <text class="dlabel" x={cx} y={up ? Math.min(ys(d.ci[1]), y1) - 6 : Math.max(ys(d.ci[0]), y1) + 14} text-anchor="middle">{moneyCents(d.mean)}</text>
          <text class="axis-text" x={cx} y={H - MB + 16} text-anchor="middle">{windowLabel(d.days)}</text>
          <rect
            x={bx - 8} y={MT} width={bw + 16} height={H - MT - MB} fill="transparent" tabindex="0"
            data-tip-value={`${moneyCents(d.mean)} saved`}
            data-tip-label={`waiting ${windowLabel(d.days)} vs ${windowLabel(d.baseline)} · ${d.pctv}% cheaper on average\n95% CI ${moneyCents(d.ci[0])} to ${moneyCents(d.ci[1])}\nbetter deal in ${pct(d.frac)} of ${d.n} paired pivots`}
          />
        </g>
      );
    })}
  </svg>
  <figcaption>Mean savings from a longer window vs the {imps.length ? windowLabel(imps[0]!.baseline) : ""} baseline; whiskers are 95% bootstrap CIs (paired pivots). A CI crossing $0 is not significant.</figcaption>
</figure>
<details class="tableview">
  <summary>Table view</summary>
  <table class="data">
    <thead><tr><th>Window</th><th class="num">Mean savings</th><th class="num">%</th><th class="num">95% CI</th><th class="num">Pivots improved</th><th class="num">n paired</th></tr></thead>
    <tbody>
      {imps.map((d) => (
        <tr>
          <td>{windowLabel(d.days)}</td>
          <td class="num">{moneyCents(d.mean)}</td>
          <td class="num">{d.pctv}%</td>
          <td class="num">{moneyCents(d.ci[0])} – {moneyCents(d.ci[1])}</td>
          <td class="num">{pct(d.frac)}</td>
          <td class="num">{d.n}</td>
        </tr>
      ))}
    </tbody>
  </table>
</details>
