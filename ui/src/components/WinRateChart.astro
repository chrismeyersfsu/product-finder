---
/** Which site supplies the winning deal: horizontal bars of win rate,
 * one bar per site entity wearing its fixed entity color (assignment
 * from the full site roster, never from what this page displays).
 * Direct label at every bar end (the relief for low-contrast slots). */
import { siteVar } from "../lib/colors";
import { moneyCents, pct } from "../lib/format";
interface Row { site: string; winRate: number; wins: number; meanPrice: number }
interface Props { rows: Row[]; knownSites: string[] }
const { rows, knownSites } = Astro.props;
const W = 720, ML = 150, MR = 90, RH = 30, MT = 6, MB = 22;
const H = MT + MB + rows.length * RH;
const maxRate = Math.max(...rows.map((r) => r.winRate), 0.001);
const xs = (v: number) => ML + (v / maxRate) * (W - ML - MR);
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Share of pivots each site supplied the best deal">
    <line x1={ML} x2={ML} y1={MT} y2={H - MB} stroke="var(--baseline)" stroke-width="1" />
    {rows.map((r, i) => {
      const y = MT + i * RH + (RH - 22) / 2;
      const w = Math.max(xs(r.winRate) - ML, 2);
      return (
        <g>
          <text class="dlabel" x={ML - 8} y={y + 15} text-anchor="end">{r.site}</text>
          <path
            d={`M${ML},${y} L${ML + w - 4},${y} Q${ML + w},${y} ${ML + w},${y + 4} L${ML + w},${y + 18} Q${ML + w},${y + 22} ${ML + w - 4},${y + 22} L${ML},${y + 22} Z`}
            fill={siteVar(r.site, knownSites)}
            tabindex="0"
            data-tip-value={pct(r.winRate, 1)}
            data-tip-label={`${r.site} won ${r.wins} pivots\nmean winning price ${moneyCents(r.meanPrice)}`}
          />
          <text class="dlabel-strong" x={ML + w + 8} y={y + 15}>{pct(r.winRate, 0)}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>Share of sampled pivots where the site had the single best qualifying price.</figcaption>
</figure>
<details class="tableview">
  <summary>Table view</summary>
  <table class="data">
    <thead><tr><th>Site</th><th class="num">Win rate</th><th class="num">Wins</th><th class="num">Mean winning price</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td><span class="swatch" style={`background:${siteVar(r.site, knownSites)}`}></span>{r.site}</td>
          <td class="num">{pct(r.winRate, 1)}</td>
          <td class="num">{r.wins}</td>
          <td class="num">{moneyCents(r.meanPrice)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</details>
