---
/** Price observations over time: scatter, series = site entity.
 * Scatter is an all-pairs form, so at most the first 3 validated
 * slots carry hues; remaining sites fold into muted "Other" (the
 * series-count ladder). Kind is the secondary channel: sold = filled
 * dot, seen = ring. Every point gets a ≥24px transparent hit target. */
import { siteSlot, siteVar } from "../lib/colors";
import type { Observation } from "../lib/db";
import { day, moneyCents } from "../lib/format";
import { niceTicks, pad, scaleLinear } from "../lib/viz";
interface Props { obs: Observation[]; knownSites: string[] }
const { obs, knownSites } = Astro.props;
const W = 720, H = 300, ML = 56, MR = 20, MT = 14, MB = 30;

const present = [...new Set(obs.map((o) => o.site_slug))];
// All-pairs form: only the first three validated slots carry hue; the
// assignment comes from the fixed roster, never from this page's data.
const top = present.filter((s) => siteSlot(s, knownSites, 3) >= 0);
const hue = (site: string) => siteVar(site, knownSites, 3);

const ts = obs.map((o) => Date.parse(o.observed_at));
const prices = obs.map((o) => o.price);
const xdom = pad([Math.min(...ts), Math.max(...ts)], 0.04);
const ydom = pad([Math.min(...prices), Math.max(...prices)]);
const xs = scaleLinear([xdom[0], xdom[1]], [ML, W - MR]);
const ys = scaleLinear([ydom[0], ydom[1]], [H - MB, MT]);
const yticks = niceTicks(ydom[0], ydom[1], 4);
const n = 4;
const xticks = Array.from({ length: n + 1 }, (_, i) => xdom[0] + ((xdom[1] - xdom[0]) * i) / n);
const legendSites = [...top, ...(present.length > top.length ? ["other sites"] : [])];
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Price observations over time by site">
    {yticks.map((t) => (
      <g>
        <line x1={ML} x2={W - MR} y1={ys(t)} y2={ys(t)} stroke="var(--grid)" stroke-width="1" />
        <text class="axis-text" x={ML - 8} y={ys(t) + 3} text-anchor="end">${t.toLocaleString()}</text>
      </g>
    ))}
    <line x1={ML} x2={W - MR} y1={H - MB} y2={H - MB} stroke="var(--baseline)" stroke-width="1" />
    {xticks.map((t, i) => (
      <text class="axis-text" x={xs(t)} y={H - MB + 16} text-anchor={i === 0 ? "start" : i === xticks.length - 1 ? "end" : "middle"}>{day(new Date(t).toISOString())}</text>
    ))}
    {obs.map((o) => {
      const cx = xs(Date.parse(o.observed_at));
      const cy = ys(o.price);
      const c = hue(o.site_slug);
      return (
        <g>
          {o.kind === "sold" ? (
            <circle cx={cx} cy={cy} r="4.5" fill={c} stroke="var(--surface-1)" stroke-width="2" />
          ) : (
            <circle cx={cx} cy={cy} r="4" fill="var(--surface-1)" stroke={c} stroke-width="2" />
          )}
          <circle
            cx={cx} cy={cy} r="12" fill="transparent" tabindex="0"
            data-tip-value={moneyCents(o.price)}
            data-tip-label={`${o.site_slug} · ${o.kind} · ${day(o.observed_at)}\n${o.title || "(no title)"}${o.score != null ? `\nscore ${o.score}` : ""}`}
          />
        </g>
      );
    })}
  </svg>
  <figcaption>Filled dot = sold price (real sale); ring = asking price seen in a search.</figcaption>
</figure>
<div class="legend" role="list">
  {legendSites.map((s) => (
    <span role="listitem"><span class="swatch" style={`background:${s === "other sites" ? "var(--other)" : hue(s)}`}></span>{s}</span>
  ))}
</div>
