---
/** Page shell: jQuery-Mobile-style header bar + off-canvas nav panel,
 * theme tokens, and the shared tooltip layer. The tooltip layer is
 * delegated: any element with data-tip-value / data-tip-label gets a
 * hover+focus tooltip; content is inserted with textContent only
 * (labels are untrusted data).
 *
 * Header bar: a hamburger (opens the nav panel) on the left by
 * default, or a `back` link when the page supplies one (the deals
 * results page uses this instead of the hamburger); an optional
 * `action` link on the right. Nav entries live in ONE array (NAV)
 * below — add a page there and it shows up in the panel everywhere.
 *
 * The panel is a native <details>: fully usable with JavaScript off
 * (the summary/hamburger opens and closes it, every link inside is a
 * real href); a small script only adds Esc-to-close on top of that.
 */
import "../styles/global.css";
interface Props {
  title: string;
  active: string;
  back?: { href: string; label: string } | undefined;
  action?: { href: string; label: string } | undefined;
  /** Seconds between auto-refreshes (a <meta http-equiv="refresh">),
   * for pages like Monitor that want to poll without client JS. */
  refreshSeconds?: number | undefined;
}
const { title, active, back, action, refreshSeconds } = Astro.props;
/** Single source of truth for the off-canvas nav. Add a row here to
 * add a page to the menu everywhere. */
const NAV: { href: string; label: string; key: string }[] = [
  { href: "/", label: "Products", key: "home" },
  { href: "/hidden", label: "Hidden", key: "hidden" },
  { href: "/sites", label: "Sites", key: "sites" },
  { href: "/monitor", label: "Monitor", key: "monitor" },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {refreshSeconds != null && <meta http-equiv="refresh" content={String(refreshSeconds)} />}
    <title>{title} · product-finder</title>
  </head>
  <body>
    <header class="jqm-header">
      <div class="hdr-left">
        {back ? (
          <a class="hdr-btn back-btn" href={back.href}>‹ {back.label}</a>
        ) : (
          <details class="panel-root">
            <summary class="hdr-btn hamburger" aria-label="Menu"><span class="ham-icon"></span></summary>
            <a class="panel-overlay" href="#" tabindex="-1" aria-hidden="true" onclick="this.closest('details').open=false;return false;"></a>
            <nav class="panel" aria-label="Site menu">
              <div class="panel-head">
                <span>Menu</span>
                <a class="panel-close" href="#" aria-label="Close menu" onclick="this.closest('details').open=false;return false;">✕</a>
              </div>
              <ul class="listview">
                {NAV.map((item) => (
                  <li>
                    <a class="ui-li" href={item.href} aria-current={active === item.key ? "page" : undefined}>
                      <span class="ui-li-text">{item.label}</span>
                      <span class="ui-li-chevron">›</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )}
      </div>
      <h1>{title}</h1>
      <div class="hdr-right">
        {action && <a class="hdr-btn action-btn" href={action.href}>{action.label}</a>}
      </div>
    </header>
    <div class="shell">
      <slot />
    </div>
    <div id="tooltip" role="status"></div>
    <script>
      // Panel: Esc closes it; the overlay/close-button onclick handlers
      // above already work with JavaScript off (native <details>).
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const open = document.querySelector("details.panel-root[open]");
        if (open) (open as HTMLDetailsElement).open = false;
      });
    </script>
    <script>
      const tip = document.getElementById("tooltip")!;
      function show(el: Element, x: number, y: number) {
        const value = el.getAttribute("data-tip-value");
        const label = el.getAttribute("data-tip-label");
        if (!value && !label) return;
        tip.replaceChildren();
        if (value) {
          const v = document.createElement("div");
          v.className = "t-value";
          v.textContent = value; // untrusted: textContent only
          tip.appendChild(v);
        }
        if (label)
          for (const line of label.split("\n")) {
            const l = document.createElement("div");
            l.className = "t-label";
            l.textContent = line;
            tip.appendChild(l);
          }
        tip.style.display = "block";
        const r = tip.getBoundingClientRect();
        tip.style.left = Math.min(x + 14, window.innerWidth - r.width - 8) + "px";
        tip.style.top = Math.min(y + 14, window.innerHeight - r.height - 8) + "px";
      }
      document.addEventListener("pointermove", (e) => {
        const el = (e.target as Element | null)?.closest?.("[data-tip-value],[data-tip-label]");
        if (el) show(el, e.clientX, e.clientY);
        else tip.style.display = "none";
      });
      document.addEventListener("focusin", (e) => {
        const el = (e.target as Element | null)?.closest?.("[data-tip-value],[data-tip-label]");
        if (!el) { tip.style.display = "none"; return; }
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.bottom);
      });
      document.addEventListener("pointerleave", () => (tip.style.display = "none"));
    </script>
    <script>
      // Shared sortable tables: any `table.data[data-sortable]` gets
      // clickable, keyboard-operable headers. Numeric columns (th.num)
      // sort numerically, first activation descending; text columns
      // case-insensitively, first activation ascending. Nulls ("—" or
      // empty) sort last in both directions; ties keep document order.
      // Direction is exposed via aria-sort (arrow drawn in CSS). On
      // narrow screens `table.cards` hides its header, so each such
      // table also gets a "Sort" select (built here) that drives the
      // same function with an explicit direction.
      type Dir = "ascending" | "descending";
      function sortBy(th: HTMLTableCellElement, want?: Dir) {
        const table = th.closest("table");
        const tbody = table?.tBodies[0];
        const headRow = th.parentElement;
        if (!table || !tbody || !headRow) return;
        const idx = Array.prototype.indexOf.call(headRow.children, th);
        const numeric = th.classList.contains("num");
        const first: Dir = numeric ? "descending" : "ascending";
        const dir: Dir = want ?? (th.getAttribute("aria-sort") === first
          ? first === "ascending" ? "descending" : "ascending"
          : first);
        for (const h of headRow.children) h.removeAttribute("aria-sort");
        th.setAttribute("aria-sort", dir);
        const key = (row: HTMLTableRowElement): number | string | null => {
          const text = (row.cells[idx]?.textContent ?? "").trim();
          if (text === "" || text === "—") return null;
          if (!numeric) return text.toLowerCase();
          const n = parseFloat(text.replace(/[$,]/g, ""));
          return Number.isNaN(n) ? null : n;
        };
        const mul = dir === "ascending" ? 1 : -1;
        Array.from(tbody.rows)
          .map((r, i) => ({ r, i, v: key(r) }))
          .sort((a, b) => {
            if (a.v == null || b.v == null)
              return a.v == null && b.v == null ? a.i - b.i : a.v == null ? 1 : -1;
            const c =
              typeof a.v === "number" && typeof b.v === "number"
                ? a.v - b.v
                : String(a.v).localeCompare(String(b.v));
            return c ? c * mul : a.i - b.i;
          })
          .forEach(({ r }) => tbody.appendChild(r));
      }
      for (const th of document.querySelectorAll<HTMLTableCellElement>(
        "table[data-sortable] thead th"
      )) {
        th.tabIndex = 0;
        th.addEventListener("click", () => sortBy(th));
        th.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            sortBy(th);
          }
        });
      }
      for (const table of document.querySelectorAll<HTMLTableElement>("table[data-sortable].cards")) {
        const ths = Array.from(table.querySelectorAll<HTMLTableCellElement>("thead th"));
        const label = document.createElement("label");
        label.className = "msort";
        label.append("Sort ");
        const sel = document.createElement("select");
        for (const [i, th] of ths.entries()) {
          const name = th.textContent?.trim();
          if (!name || th.classList.contains("col-blank")) continue;
          const numeric = th.classList.contains("num");
          for (const dir of (numeric ? ["descending", "ascending"] : ["ascending", "descending"]) as Dir[]) {
            const opt = document.createElement("option");
            opt.value = `${i}:${dir}`;
            opt.textContent = `${name} ${dir === "ascending" ? "↑" : "↓"}`;
            if (th.getAttribute("aria-sort") === dir) opt.selected = true;
            sel.appendChild(opt);
          }
        }
        sel.addEventListener("change", () => {
          const [i, dir] = sel.value.split(":");
          const th = ths[Number(i)];
          if (th) sortBy(th, dir as Dir);
        });
        label.appendChild(sel);
        table.parentElement?.insertBefore(label, table);
      }
    </script>
  </body>
</html>
